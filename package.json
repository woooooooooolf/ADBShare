{
  "name": "adbshare",
  "version": "0.8.0",
  "author": "wooooooooolf",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "build:app": "node scripts/build-app.mjs",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "test:integration": "node scripts/tests/integration.mjs",
    "test:ui": "node scripts/tests/ui-smoke.mjs",
    "version:check": "node scripts/version.mjs",
    "package": "pwsh -NoProfile -File scripts/package.ps1",
    "format": "prettier --write src \"scripts/**/*.mjs\" package.json tsconfig.json .prettierrc.json .github/workflows/build-release.yml README.md CHANGELOG.md \"docs/*.md\" && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check src \"scripts/**/*.mjs\" package.json tsconfig.json .prettierrc.json .github/workflows/build-release.yml README.md CHANGELOG.md \"docs/*.md\"",
    "clean": "pwsh -NoProfile -File scripts/clean.ps1",
    "test:release": "node --test scripts/tests/release.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
