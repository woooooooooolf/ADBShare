{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADBShare",
  "version": "0.10.0",
  "identifier": "local.adbshare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ADBShare", "width": 1240, "height": 840, "minWidth": 640, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
